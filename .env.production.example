APP_NAME="LMS Villa Merah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lmsvillamerah.sivmi.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@lmsvillamerah.sivmi.id
MAIL_FROM_NAME="${APP_NAME}"

JITSI_DOMAIN=8x8.vc
JITSI_ROOM_PREFIX=VillaMerah
JITSI_APP_ID=
JITSI_KEY_ID=
JITSI_PRIVATE_KEY_PATH=
JITSI_PRIVATE_KEY_BASE64=
JITSI_MAX_TOKEN_HOURS=6
